# Required for Claude-powered generation and analysis
ANTHROPIC_API_KEY=

# 32-byte AES-256 key, represented as 64 hexadecimal characters.
# Generate locally with: openssl rand -hex 32
AUTOSEO_ENCRYPTION_KEY=

# Production: set this to a strong random value and use it for the application secret.
# Future Supabase migration should use Supabase Auth + Postgres instead of the local JSON store.
AUTOSEO_APP_SECRET=

# Production SaaS foundation (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTOSEO_AUTH_REQUIRED=false
# Development may keep this false for the local demo.
# Production (NODE_ENV=production) always requires authentication even if this is omitted or false.

# Nexora platform admin console. Comma-separated emails.
NEXORA_PLATFORM_ADMIN_EMAILS=
NEXORA_SUPPORT_EMAIL=
NEXORA_LEGAL_BUSINESS_NAME=Nexora
# none | gopayfast | rapid-gateway
NEXORA_BILLING_PROVIDER=none
# Free Beta default. Set to false only when a real billing provider is going live.
NEXORA_BETA_MODE=true

# V5 database mode
# When Supabase is configured and AUTOSEO_AUTH_REQUIRED=true, workspace APIs
# use Supabase PostgREST + RLS instead of local data/db.json.

# V6 durable worker
AUTOSEO_WORKER_SECRET=replace-with-a-long-random-secret
# V7 scheduler. Configure your hosting cron to call /api/cron/autoseo.
CRON_SECRET=replace-with-a-long-random-secret

# V9 browser authentication
# Production always requires a verified session regardless of this flag.
# Keep false only for local demo without login.

# V12 OAuth integrations
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth may be used for YouTube and Search Console analytics.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v20.0
# V13 provider lifecycle
# Cron/worker health checks use the same worker secret.
