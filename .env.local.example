# Current AIBISORA production variables

NEXT_PUBLIC_APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=

# Supabase Auth + Postgres (required for public beta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte AES-256 key as 64 hex characters: openssl rand -hex 32
AUTOSEO_ENCRYPTION_KEY=

# Production application secret (internal legacy name AUTOSEO_APP_SECRET)
AUTOSEO_APP_SECRET=

# Production always requires authentication even if this is omitted or false.
# Keep false only for local demo without login.
AUTOSEO_AUTH_REQUIRED=false

# Durable worker + scheduler (internal legacy AUTOSEO_* names)
AUTOSEO_WORKER_SECRET=replace-with-a-long-random-secret
# Optional: comma-separated workspace IDs this worker may health-check.
# AUTOSEO_WORKER_WORKSPACE_IDS=
CRON_SECRET=replace-with-a-long-random-secret

# Optional customer-facing legal/support labels
AIBISORA_SUPPORT_EMAIL=
AIBISORA_LEGAL_BUSINESS_NAME=AIBISORA

# Google OAuth — YouTube Data API v3 + YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta / Facebook OAuth — Graph API v26.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

# Optional integrations
# Search Console uses the same Google OAuth client with webmasters.readonly.

# LEGACY INTERNAL VARIABLES
# These names remain for database/env compatibility. Do not treat them as the
# current product brand. Prefer AIBISORA_* aliases where both exist.
NEXORA_PLATFORM_ADMIN_EMAILS=
NEXORA_SUPPORT_EMAIL=
NEXORA_LEGAL_BUSINESS_NAME=AIBISORA

# BETA billing variables — keep billing OFF for Free Beta
# none | gopayfast | rapid-gateway
NEXORA_BILLING_PROVIDER=none
# Free Beta default. Set to false only when a real billing provider is going live.
NEXORA_BETA_MODE=true

# V5 database mode
# When Supabase is configured and AUTOSEO_AUTH_REQUIRED=true, workspace APIs
# use Supabase PostgREST + RLS instead of local data/db.json.

# V7 scheduler. Configure hosting cron to call /api/cron/autoseo (legacy path).
# Vercel Hobby does not support "* * * * *". Use Pro/Enterprise or an external HTTPS scheduler.
